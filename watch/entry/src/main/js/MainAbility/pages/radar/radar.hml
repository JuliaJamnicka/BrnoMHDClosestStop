<stack class="screen" onswipe="onSwipe">
    <div class="ring-outer"></div>
    <div class="ring-inner"></div>
    <div class="cross-v"></div>
    <div class="cross-h"></div>
    <text class="north" style="left: {{northLeft}}px; top: {{northTop}}px;">N</text>
    <text class="label-inner" onclick="nextZoom">{{innerLabel}}</text>
    <text class="label-outer" onclick="nextZoom">{{outerLabel}}</text>
    <div for="{{stops}}" class="stop-dot" style="left: {{$item.left}}px; top: {{$item.top}}px;"></div>
    <text for="{{stopLabels}}" class="stop-label" style="left: {{$item.left}}px; top: {{$item.top}}px;">{{$item.text}}</text>
    <div class="halo"></div>
    <div class="me"></div>
    <image for="{{arrows}}" class="arrow" src="{{$item.arrow}}" style="left: {{$item.arrowLeft}}px; top: {{$item.arrowTop}}px;"></image>
    <div for="{{markers}}" class="badge" onclick="pickVehicle($idx)" style="left: {{$item.left}}px; top: {{$item.top}}px; width: {{$item.width}}px; background-color: {{$item.badgeColour}}; border-radius: {{$item.badgeRadius}}px;">
        <text class="badge-text" style="width: {{$item.width}}px; color: {{$item.textColour}};">{{$item.line}}</text>
    </div>
    <div if="{{hasCard}}" class="card" onclick="closeCard">
        <div class="card-row">
            <div class="card-badge" style="width: {{card.badgeWidth}}px; background-color: {{card.badgeColour}}; border-radius: {{card.badgeRadius}}px;">
                <text class="card-badge-text" style="width: {{card.badgeWidth}}px;">{{card.line}}</text>
            </div>
            <text class="card-headsign" style="width: {{card.headsignWidth}}px;">{{card.headsign}}</text>
        </div>
        <text class="card-info" style="color: {{card.infoColour}};">{{card.info}}</text>
    </div>
    <text if="{{hasStatus}}" class="status">{{status}}</text>
    <slider ref="zoom" class="zoom" min="0" max="2" value="{{zoom}}" onchange="onZoom"></slider>
</stack>
