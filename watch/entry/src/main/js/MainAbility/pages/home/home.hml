<div class="screen" onswipe="onSwipe">
    <div if="{{view === 'loading'}}" class="center">
        <image class="logo" src="/common/images/logo.png"></image>
        <text class="title">{{loadingText}}</text>
    </div>

    <div if="{{view === 'error'}}" class="center">
        <text class="title error-title">{{errorTitle}}</text>
        <text class="hint">{{errorHint}}</text>
        <input type="button" class="button" value="{{retryText}}" onclick="load"></input>
    </div>

    <div if="{{view === 'dep'}}" class="page">
        <image class="now-mark" src="/common/images/now.png"></image>
        <div class="header">
            <image if="{{pinned}}" class="pin" src="/common/images/pin.png" onclick="unpin"></image>
            <text class="stop" onclick="openPlatforms">{{stop}}</text>
        </div>
        <div class="direction-row">
            <text class="direction">{{direction}}</text>
            <div if="{{canReverse}}" class="round-button" onclick="reverse">
                <image class="icon" src="/common/images/reverse.png"></image>
            </div>
        </div>
        <div class="rows">
            <text if="{{empty}}" class="hint">{{noDeparturesText}}</text>
            <div for="{{rows}}" class="row">
                <div class="badge" style="background-color: {{$item.badgeColour}}; border-radius: {{$item.badgeRadius}}px;">
                    <text class="badge-text">{{$item.line}}</text>
                </div>
                <text class="headsign">{{$item.headsign}}</text>
                <text class="delay">{{$item.delay}}</text>
                <div if="{{$item.live}}" class="live-dot"></div>
                <text class="time" style="color: {{$item.timeColour}};">{{$item.big}}</text>
            </div>
        </div>
        <text if="{{staleText}}" class="stale-text">{{staleText}}</text>
        <div class="footer">
            <div class="round-button" onclick="openStops">
                <image class="icon" src="/common/images/list.png"></image>
            </div>
            <text class="distance">{{distance}}</text>
            <div class="round-button" onclick="openRadar">
                <image class="icon" src="/common/images/radar.png"></image>
            </div>
        </div>
    </div>
</div>
