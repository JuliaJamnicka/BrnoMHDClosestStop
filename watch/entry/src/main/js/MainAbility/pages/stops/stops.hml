<div class="screen" onswipe="onSwipe">
    <image class="now-mark" src="/common/images/now.png"></image>
    <text class="title">{{title}}</text>
    <list ref="list" class="list">
        <list-item class="item" onclick="pickNearest">
            <div class="rule"></div>
            <div class="item-content">
                <text class="auto">{{autoText}}</text>
            </div>
        </list-item>
        <!-- loading or error under "Nearest (automatic)", which so stays at the top -->
        <list-item for="{{messages}}" class="message-item">
            <div class="rule"></div>
            <text class="hint">{{$item}}</text>
        </list-item>
        <list-item for="{{stops}}" class="item" onclick="pick($idx)">
            <div class="rule"></div>
            <div class="item-content">
                <div class="name-column">
                    <text class="name">{{$item.name}}</text>
                    <div class="chips">
                        <image if="{{$item.has0}}" class="chip" src="{{$item.c0}}" style="width: {{$item.w0}}px;"></image>
                        <image if="{{$item.has1}}" class="chip" src="{{$item.c1}}" style="width: {{$item.w1}}px;"></image>
                        <image if="{{$item.has2}}" class="chip" src="{{$item.c2}}" style="width: {{$item.w2}}px;"></image>
                    </div>
                </div>
                <text class="distance">{{$item.distance}}</text>
            </div>
        </list-item>
    </list>
</div>
