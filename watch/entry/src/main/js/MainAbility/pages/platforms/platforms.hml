<div class="screen" onswipe="onSwipe">
    <text class="title">{{title}}</text>
    <text if="{{message}}" class="hint">{{message}}</text>
    <list class="list">
        <list-item for="{{platforms}}" class="item" onclick="pick($idx)">
            <text class="name">{{$item.lines}}</text>
            <text class="detail">{{$item.direction}}</text>
        </list-item>
    </list>
</div>
