<div class="screen" onswipe="onSwipe">
    <image class="now-mark" src="/common/images/now.png"></image>
    <text class="title">{{title}}</text>
    <text if="{{hasMessage}}" class="hint">{{message}}</text>
    <list ref="list" class="list">
        <list-item for="{{platforms}}" class="item" onclick="pick($idx)">
            <div class="rule"></div>
            <div class="item-content">
                <text class="name">{{$item.lines}}</text>
                <text class="detail">{{$item.direction}}</text>
            </div>
        </list-item>
    </list>
</div>
