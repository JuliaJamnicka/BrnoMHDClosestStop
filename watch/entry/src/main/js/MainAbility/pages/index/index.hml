<div class="screen" onswipe="onSwipe">
    <div if="{{view === 'loading'}}" class="center">
        <image class="logo" src="/common/images/logo.png"></image>
        <text class="title">{{loadingText}}</text>
        <text class="subtitle">{{loadingSubText}}</text>
    </div>

    <div if="{{view === 'error'}}" class="center">
        <image if="{{hasErrorIcon}}" class="error-icon" src="{{errorIcon}}"></image>
        <text class="title">{{errorTitle}}</text>
        <text for="{{errorLines}}" class="hint-line">{{$item}}</text>
        <input type="button" class="button" value="{{retryText}}" onclick="load"></input>
    </div>

    <div if="{{view === 'dep'}}" class="page">
        <image class="now-mark" src="/common/images/now.png"></image>
        <div class="header">
            <image if="{{pinned}}" class="pin" src="/common/images/pin.png" onclick="unpin"></image>
            <text class="stop" style="width: {{stopWidth}}px;" onclick="openPlatforms">{{stop}}</text>
        </div>
        <div class="direction-row">
            <text class="direction">{{direction}}</text>
            <div if="{{canReverse}}" class="round-button" onclick="reverse">
                <image class="icon" src="/common/images/reverse.png"></image>
            </div>
        </div>
        <!-- 4 rows fit; more scroll (swipe or crown; the phone app's departure count), header and footer stay -->
        <div class="rows-box">
            <stack class="rows-area">
                <list ref="rows" class="rows">
                    <list-item for="{{rows}}" class="row">
                        <div class="rule"></div>
                        <div class="row-content">
                            <div class="badge" style="background-color: {{$item.badgeColour}}; border-radius: {{$item.badgeRadius}}px;">
                                <text class="badge-text">{{$item.line}}</text>
                            </div>
                            <text class="headsign" style="width: {{$item.headsignWidth}}px; color: {{$item.headsignColour}};">{{$item.headsign}}</text>
                            <text if="{{$item.hasDelay}}" class="delay">{{$item.delay}}</text>
                            <div if="{{$item.live}}" class="live"></div>
                            <text class="time" style="width: {{$item.timeWidth}}px; color: {{$item.timeColour}};">{{$item.big}}</text>
                            <image if="{{$item.hasUnit}}" class="unit" src="{{$item.unitImage}}"></image>
                        </div>
                    </list-item>
                </list>
                <text if="{{empty}}" class="hint">{{noDeparturesText}}</text>
            </stack>
        </div>
        <!-- everything below the departures: swiping up here opens the stop list (up on the rows scrolls them) -->
        <div class="bottom" onswipe="bottomSwipe">
            <div class="footer">
                <div class="round-button" onclick="openStops">
                    <image class="icon" src="/common/images/list.png"></image>
                </div>
                <div class="footer-middle">
                    <text if="{{isStale}}" class="stale-text">{{staleText}}</text>
                    <image if="{{showDistance}}" class="loc" src="/common/images/loc.png"></image>
                    <text if="{{showDistance}}" class="distance">{{distance}}</text>
                </div>
                <div class="round-button" onclick="openRadar">
                    <image class="icon" src="/common/images/radar.png"></image>
                </div>
            </div>
        </div>
    </div>
</div>
