{
  "app": {
    // DevEco Studio adds "signingConfigs" here when you set up signing (File > Project Structure > Signing Configs);
    // keep those files (*.p12, *.cer, *.p7b) out of git.
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "5.1.0(18)",
        "compatibleSdkVersion": "4.0.0(10)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": false
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        { "name": "default", "applyToProducts": ["default"] }
      ]
    }
  ]
}
